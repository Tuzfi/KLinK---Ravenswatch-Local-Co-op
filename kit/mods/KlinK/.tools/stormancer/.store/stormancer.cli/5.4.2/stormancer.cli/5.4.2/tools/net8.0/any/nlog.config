<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <targets>
    <target xsi:type="ColoredConsole" name="console" useDefaultRowHighlightingRules="false">
      <highlight-word  foregroundColor="DarkGreen" ignoreCase="true"
                    regex="^(.*?)(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="DarkGray" ignoreCase="true"
                      regex="(?!\|)TRACE(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="Gray" ignoreCase="true"
                      regex="(?!\|)DEBUG(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="Blue" ignoreCase="true"
                      regex="(?!\|)INFO(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="Yellow" ignoreCase="true"
                      regex="(?!\|)WARN(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="Red" ignoreCase="true"
                        regex="(?!\|)ERROR(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="White" backgroundColor="Red" ignoreCase="true"
                        regex="(?!\|)FATAL(?=\|)"  wholeWords="false" compileRegex="true"/>
      <highlight-word  foregroundColor="Cyan" ignoreCase="true"
                            regex="(?!(?:.*?\|){2})(.*?)(?=\|)"  wholeWords="false" compileRegex="true"/>
      <!--Node id-->
      <highlight-word foregroundColor="Yellow" ignoreCase="true"
                      regex="\[[a-z0-9]+\([0-9]+\)\]"  wholeWords="false" compileRegex="true"/>
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="console"/>
  </rules>
</nlog>